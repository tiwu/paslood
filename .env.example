# Wealth Pilot Environment Configuration
# Copy this file to .env and configure as needed.

# ------------------------------------------------------------------------------
# Operational Mode & Storage
# ------------------------------------------------------------------------------
# Mode: "local" (single user, no auth required on localhost),
#       "self_host" (requires auth when bound to public interfaces),
#       "saas" (strict multi-tenant isolation, OAuth/password required)
WEALTH_PILOT_MODE=self_host

# Directory where portfolios, SQLite database, and secrets are stored.
# In Docker, this is mounted to /data.
WEALTH_PILOT_DATA_DIR=/data

# Master secret key for session HMAC signing and envelope encryption key derivation.
# Generate with: openssl rand -hex 32
WEALTH_PILOT_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Auth mode: "none" (local only), "password", "oauth", or "both"
WEALTH_PILOT_AUTH_MODE=both

# Optional comma-separated list of allowed user emails (whitelisting for private self-host)
# Leave empty to allow any authenticated user.
WEALTH_PILOT_ALLOWED_EMAILS=

# Comma-separated list of trusted Origin / Referer hosts for CORS & CSRF defense
WEALTH_PILOT_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Admin password hash (optional initial setup; can also set via `wealth-pilot set-password`)
# WEALTH_PILOT_ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------------------------
# Social OAuth Providers (Optional - enable any you need)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Console: https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://<your-domain>/auth/google/callback
WEALTH_PILOT_GOOGLE_CLIENT_ID=
WEALTH_PILOT_GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (Settings -> Developer Settings -> OAuth Apps)
# Authorization callback URL: https://<your-domain>/auth/github/callback
WEALTH_PILOT_GITHUB_CLIENT_ID=
WEALTH_PILOT_GITHUB_CLIENT_SECRET=

# Meta / Facebook Login (Meta for Developers -> App -> Facebook Login)
# Valid OAuth Redirect URI: https://<your-domain>/auth/meta/callback
WEALTH_PILOT_META_CLIENT_ID=
WEALTH_PILOT_META_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Remote Access Sidecars (Tailscale / Cloudflare / DuckDNS)
# ------------------------------------------------------------------------------
# Tailscale auth key (ephemeral or reusable, from https://login.tailscale.com/admin/settings/keys)
TAILSCALE_AUTHKEY=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# DuckDNS Domain and Token (for Dynamic DNS with Caddy)
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
ACME_EMAIL=admin@example.com
